# ============================================================
# 环境与密钥（.env 里放 LLM_API_KEY，绝不入库）
# ============================================================
.env
.env.local
.env.*.local
*.key
*.pem

# ============================================================
# 运行数据：语料、向量库、SQLite 索引、账号库、BM25、上报统计全部不入库
#
# 注意写法必须是 data/* + !data/.gitkeep，不能写成 data/。
# 一旦整目录被排除，git 不会进入该目录，后面再 !data/.gitkeep 也不会生效。
# ============================================================
data/*
!data/.gitkeep
# 评测时用 --data-dir 指定的独立数据目录
data-eval/
*.pkl
*.db
*.sqlite3
*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ============================================================
# 编辑器与系统
# ============================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 部署产物与临时文件
# ============================================================
# 隧道凭据与配置：里面的 tunnel id / 域名是环境相关的，示例见
# cloudflared-config.example.yml，真实配置不要提交
cloudflared-config.yml
*.bak
*.bak.*
# Office 打开文档时生成的锁文件
~$*

# ============================================================
# 本地临时脚本与产物（不要提交）
# ============================================================
# 注意写法：必须是 _*tmp* 而不是 _calib_tmp*。
# 后者匹配不到 _calib2_tmp.py / _ab_tmp.py / _e2e_tmp.py 这类带序号或前缀变体，
# 会让标定脚本和它们的输出一起被提交。
_*tmp*
_scratch*
*.tmp

